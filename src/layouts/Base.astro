---
import { site, nav } from '../data/site.js';
import { services } from '../data/services.js';
import QuoteSection from '../components/QuoteSection.astro';

const {
  title,
  description,
  state = null,        // 'qld' | 'nsw' to lock the page to one state brand
  home = false,
  quote = true,
  schema = [],
  breadcrumbs = [],    // [{ label, href }]
  ogType = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const abs = (p) => new URL(p, Astro.site).href;
const path = Astro.url.pathname;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': abs('/#business'),
  name: state ? site.brands[state] : site.name,
  url: abs('/'),
  telephone: '+61439289234',
  email: site.email,
  image: abs('/assets/brand/logo-qld.png'),
  logo: abs('/assets/brand/logo-qld.png'),
  areaServed: [
    { '@type': 'State', name: 'Queensland' },
    { '@type': 'State', name: 'New South Wales' },
    { '@type': 'State', name: 'Victoria' },
  ],
  parentOrganization: { '@type': 'Organization', name: site.parent.name, url: site.parent.url },
  sameAs: [site.social.qld, site.social.nsw],
};
const crumbSchema = breadcrumbs.length && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.label, item: abs(c.href),
  })),
};
const allSchema = [orgSchema, crumbSchema, ...schema].filter(Boolean);
---
<!DOCTYPE html>
<html lang="en-AU" data-state={state ?? 'qld'} data-force={state}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta name="theme-color" content="#141210">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={abs(`/assets/brand/logo-${state ?? 'qld'}.png`)}>
<meta property="og:locale" content="en_AU">
<meta name="twitter:card" content="summary">
<link rel="icon" href="/assets/brand/logo-qld.png">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="alternate" type="application/rss+xml" title="Bushfire Assessments articles" href="/rss.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
<slot name="head" />
<script is:inline>
  (function () {
    var d = document.documentElement; d.classList.add('js');
    try {
      var f = d.dataset.force;
      if (f) localStorage.setItem('bfa-state', f);
      else { var s = localStorage.getItem('bfa-state'); if (s === 'nsw' || s === 'qld' || s === 'vic') d.dataset.state = s; }
    } catch (e) {}
  })();
</script>
{allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body class={home ? 'is-home' : 'is-inner'}>

{home && (
  <div class="preloader" aria-hidden="true">
    <div class="preloader__inner">
      <img src="/assets/brand/logo-qld.webp" alt="" width="440" height="436" class="preloader__logo">
      <div class="preloader__bar"><span></span></div>
      <div class="preloader__count"><span data-count>0</span>%</div>
    </div>
  </div>
)}

<a class="skip" href="#main">Skip to content</a>

<header class="header" data-header>
  <a class="brand" href="/" aria-label={`${site.name} home`}>
    <img class="brand__logo brand__logo--qld" src="/assets/brand/logo-qld.webp" alt={site.brands.qld} width="440" height="436">
    <img class="brand__logo brand__logo--nsw" src="/assets/brand/logo-nsw.webp" alt={site.brands.nsw} width="440" height="436">
    <img class="brand__logo brand__logo--vic" src="/assets/brand/logo-vic.webp" alt={site.brands.vic} width="440" height="436">
  </a>

  <nav class="nav" id="nav" aria-label="Main">
    {nav.map((n) => <a href={n.href} title={n.title} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.live && <span class="live-dot" aria-hidden="true"></span>}{n.label}</a>)}
  </nav>

  <div class="header__actions">
    {!state && (
      <div class="state-toggle" role="group" aria-label="Choose your state">
        <button type="button" data-set-state="qld" aria-pressed="true">QLD</button>
        <button type="button" data-set-state="nsw" aria-pressed="false">NSW</button>
        <button type="button" data-set-state="vic" aria-pressed="false">VIC</button>
        <span class="state-toggle__pill" aria-hidden="true"></span>
      </div>
    )}
    <a class="header__phone" href={site.phoneHref}>{site.phone}</a>
    <a class="btn btn--primary btn--sm" href={quote ? '#quote' : '/contact/'} data-magnetic><span>Get a quote</span></a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="nav" data-menu-btn>
      <span class="sr-only">Menu</span><i></i><i></i>
    </button>
  </div>
</header>

<main id="main">
  <slot />
  {quote && <QuoteSection state={state} />}
</main>

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <div class="brand brand--footer">
        <img class="brand__logo brand__logo--qld" src="/assets/brand/logo-qld.webp" alt={site.brands.qld} width="440" height="436" loading="lazy">
        <img class="brand__logo brand__logo--nsw" src="/assets/brand/logo-nsw.webp" alt={site.brands.nsw} width="440" height="436" loading="lazy">
        <img class="brand__logo brand__logo--vic" src="/assets/brand/logo-vic.webp" alt={site.brands.vic} width="440" height="436" loading="lazy">
      </div>
      <p class="muted">Bushfire assessments across Queensland, New South Wales and Victoria. A service of <a href={site.parent.url} rel="noopener">{site.parent.name}</a>.</p>
      <p><a class="footer__phone" href={site.phoneHref}>{site.phone}</a><br><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <nav aria-label="Services">
      <h2>Services</h2>
      {services.map((s) => <a href={`/services/${s.slug}/`}>{s.name}</a>)}
    </nav>
    <nav aria-label="Areas">
      <h2>Areas</h2>
      <a href="/qld/">Queensland</a>
      <a href="/nsw/">New South Wales</a>
      <a href="/vic/">Victoria</a>
      <a href="/property-check/">Property check</a>
      <a href={site.social.qld} rel="noopener">Facebook (QLD)</a>
      <a href={site.social.nsw} rel="noopener">Facebook (NSW)</a>
    </nav>
    <nav aria-label="Company">
      <h2>Company</h2>
      <a href="/about/">About</a>
      <a href="/process/">Process</a>
      <a href="/faq/">FAQ</a>
      <a href="/blog/">Articles</a>
      <a href="/bushfires/">Current bushfires</a>
      <a href="/contact/">Contact</a>
    </nav>
  </div>
  <div class="footer__word" aria-hidden="true">Bushfire Assessments</div>
  <div class="container footer__bottom"><span>&copy; {new Date().getFullYear()} {site.name}</span><span>Queensland &middot; New South Wales &middot; Victoria</span></div>
</footer>

<button class="motion-btn" type="button" data-motion-btn aria-pressed="false">Pause motion</button>

<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.20/dist/lenis.min.js" defer></script>
<script is:inline src="/js/main.js" defer></script>
</body>
</html>
