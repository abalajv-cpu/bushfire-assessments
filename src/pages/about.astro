---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Sections from '../components/Sections.astro';
import { site } from '../data/site.js';
const crumbs = [{ label: 'About', href: '/about/' }];
const sections = [
  { h: 'Who we are', p: [
    `Bushfire Assessments Queensland and Bushfire Assessments New South Wales are the residential and development assessment services of ${site.parent.name}, a fire risk planning and design consultancy that works across Australia.`,
    `Our northern office is in ${site.office}, which puts us close to northern New South Wales and southern Queensland, and we assess sites throughout both states.`,
  ] },
  { h: 'What we do', p: [
    'We provide bushfire assessments in accordance with AS 3959 and the requirements of each state: Queensland fire service requirements and local planning schemes in Queensland, and Planning for Bush Fire Protection 2019 in New South Wales.',
    'That covers BAL assessment reports for individual homes, planning scheme assessments, and bushfire reporting for subdivisions and larger developments.',
  ] },
  { h: 'Who we work with', list: [
    'Home owners and owner builders',
    'Builders and building designers',
    'Architects and town planners',
    'Developers and surveyors',
    'Certifiers and councils',
  ] },
  { h: 'How we work', p: [
    'Clear, practical bushfire advice. Every report is specific to the site, written so that your council, certifier and builder can act on it, and we stay available to answer questions after it is lodged.',
  ] },
];
---
<Base title="About Bushfire Assessments | Queensland & New South Wales"
  description="Bushfire Assessments Queensland and NSW provide BAL reports and planning assessments in accordance with AS 3959. A service of Agilus, with an office in Tenterfield."
  breadcrumbs={crumbs}>
  <PageHero eyebrow="About" title="Clear, practical bushfire advice" breadcrumbs={crumbs}
    lead="We help owners, builders and designers in Queensland and New South Wales understand their bushfire risk and get the reports their approvals need." />
  <div class="container split block">
    <Sections sections={sections} />
    <aside class="aside" data-reveal>
      <h2 class="aside__title">Contact</h2>
      <a class="aside__link" href={site.phoneHref}>{site.phone} <i aria-hidden="true">&rarr;</i></a>
      <a class="aside__link" href={`mailto:${site.email}`}>{site.email} <i aria-hidden="true">&rarr;</i></a>
      <h2 class="aside__title">Part of</h2>
      <a class="aside__link" href={site.parent.url} rel="noopener">{site.parent.name} <i aria-hidden="true">&rarr;</i></a>
    </aside>
  </div>
</Base>
