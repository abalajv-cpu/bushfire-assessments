---
const { eyebrow, title, lead, breadcrumbs = [], cta = true } = Astro.props;
---
<section class="page-hero">
  <div class="page-hero__glow" aria-hidden="true"></div>
  <canvas class="page-hero__embers" data-embers aria-hidden="true"></canvas>
  <div class="container page-hero__inner">
    {breadcrumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb" data-hero-fade>
        <a href="/">Home</a>
        {breadcrumbs.map((c, i) => i === breadcrumbs.length - 1
          ? <span aria-current="page">{c.label}</span>
          : <a href={c.href}>{c.label}</a>)}
      </nav>
    )}
    {eyebrow && <p class="eyebrow" data-hero-fade>{eyebrow}</p>}
    <h1 class="h1" data-split-now>{title}</h1>
    {lead && <p class="page-hero__lead" data-hero-fade>{lead}</p>}
    {cta && (
      <div class="hero__cta" data-hero-fade>
        <a class="btn btn--primary" href="#quote" data-magnetic><span>Get a quote</span></a>
        <a class="btn btn--ghost" href="tel:+61439289234" data-magnetic><span>Call 0439 289 234</span></a>
      </div>
    )}
  </div>
</section>
