    "build:offline": "astro build && node scripts/apply-base.mjs",
    "preview": "astro preview --port 4173"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.10"
  }
}